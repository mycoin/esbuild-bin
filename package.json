{
  "name": "esbuild-bin",
  "version": "1.0.0",
  "description": "A lightweight front-end build tool based on esbuild, focusing on two core scenarios: browser-running projects and npm library building.",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "typings": "lib/index.d.ts",
  "bin": {
    "esbuild-bin": "cli.js"
  },
  "scripts": {
    "dev": "node build.js watch",
    "build": "node build.js"
  },
  "files": [
    "lib",
    "cli.js"
  ],
  "keywords": [
    "esbuild"
  ],
  "author": {
    "name": "mycoin",
