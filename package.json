  },
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "cosmiconfig": "^9.0.2",
    "esbuild": "^0.28.0",
    "esbuild-plugin-progress": "^1.3.9",
    "esbuild-sass-plugin": "^3.7.0",
    "fs-extra": "^11.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/cosmiconfig": "^6.0.3",
    "@types/node": "^25.3.3"
  }
